# Copy to .env.local for local development.
# Pull from Vercel: vercel env pull .env.local

# Optional — AI agent panel (DeepSeek)
VITE_DEEPSEEK_KEY=

# Required for sign-in and cloud project sync
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — OAuth redirect (defaults to current origin + ?studio)
# VITE_AUTH_REDIRECT_URL=http://localhost:5173/?studio
